---
// Popover API: Esc, closing on an outside click, aria-expanded and focus return are native.
// Fixed label (ui.menu.label) plus the native expanded state, as in the APG disclosure pattern;
// only the icon switches, through CSS while the popover is open.
// The panel sits in the top layer, right-aligned under the header bar.
import type { Locale } from '../../i18n/config';
import { getContent } from '../../i18n/utils';
import Icon from '../ui/Icon.astro';
import Nav from './Nav.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { ui } = getContent(lang);
---

<div class="group lg:hidden">
  <button
    type="button"
    popovertarget="mobile-menu"
    class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-text hover:text-accent"
  >
    <span class="sr-only">{ui.menu.label}</span>
    <Icon name="menu" class="group-has-[:popover-open]:hidden" />
    <Icon name="close" class="hidden group-has-[:popover-open]:block" />
  </button>
  <div
    id="mobile-menu"
    popover
    class="glass top-[calc(var(--header-offset)+0.5rem)] right-(--header-gap) left-(--header-gap) ms-auto max-h-[calc(100dvh-var(--header-offset)-1rem)] w-auto max-w-80 overflow-y-auto rounded-2xl p-2 text-text lg:hidden"
  >
    <Nav lang={lang} orientation="vertical" />
  </div>
</div>

<script>
  // Close the menu after jumping to a section, and when focus leaves it for the page.
  const menu = document.getElementById('mobile-menu');
  const toggle = document.querySelector('[popovertarget="mobile-menu"]');

  if (menu) {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.hidePopover();
      }
    });
    // Stays open when focus goes nowhere (relatedTarget is null after a click on a non-focusable
    // part of the panel) and on Shift+Tab back to its own button.
    menu.addEventListener('focusout', ({ relatedTarget }) => {
      if (
        relatedTarget instanceof Node &&
        relatedTarget !== toggle &&
        !menu.contains(relatedTarget)
      ) {
        menu.hidePopover();
      }
    });
  }
</script>
