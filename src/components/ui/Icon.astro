---
// Inline SVG icons on a 24×24 grid with a 2px stroke.
// github and linkedin come from Tabler Icons v3.49.0 (MIT, notice in
// public/THIRD-PARTY-NOTICES.txt), with their paths copied unchanged from:
// https://github.com/tabler/tabler-icons/blob/v3.49.0/icons/outline/brand-github.svg
// https://github.com/tabler/tabler-icons/blob/v3.49.0/icons/outline/brand-linkedin.svg
const icons = {
  sun: [
    'M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0',
    'M12 3v2.5',
    'M12 18.5V21',
    'M3 12h2.5',
    'M18.5 12H21',
    'M5.64 5.64l1.77 1.77',
    'M16.59 16.59l1.77 1.77',
    'M5.64 18.36l1.77-1.77',
    'M16.59 7.41l1.77-1.77',
  ],
  moon: ['M12 3a9 9 0 1 0 9 9a7 7 0 0 1-9-9z'],
  menu: ['M4 6h16', 'M4 12h16', 'M4 18h16'],
  close: ['M6 6l12 12', 'M18 6L6 18'],
  github: [
    'M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5',
  ],
  linkedin: [
    'M8 11v5',
    'M8 8v.01',
    'M12 16v-5',
    'M16 16v-3a2 2 0 1 0 -4 0',
    'M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10',
  ],
} satisfies Record<string, string[]>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {icons[name].map((d) => (
    <path d={d} />
  ))}
</svg>
