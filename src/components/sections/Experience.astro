---
// Experience (spec §6.2) in a SectionCard, one article per job. From lg, two columns split by a
// thin rule: role, company, period and location, the description followed by the context, and
// the technologies box on the left; the highlights on the right. Without JS the highlights are
// stacked, each with its h4; with JS they are APG tabs (scripts/tabs.ts, .tab-panels).
// experience.labels are not shown (PLAN task 9). Texts that start in lowercase get a visual
// capital through capitalizeFirst; technology names keep their own casing (jQuery).
// The vertical space is margin, not padding, so a jump to #experience lands on the tab.
import type { Locale } from '../../i18n/config';
import { capitalizeFirst, getContent } from '../../i18n/utils';
import SectionCard from '../ui/SectionCard.astro';
import TechPill from '../ui/TechPill.astro';

interface Props {
  lang: Locale;
}

const SECTION_ID = 'experience';

const { lang } = Astro.props;
const { experience, ui } = getContent(lang);

// The nav links to #experience: fail the build if the id ever drifts from ui.nav.items.
if (!ui.nav.items.some(({ id }) => id === SECTION_ID)) {
  throw new Error(`ui.nav.items has no "${SECTION_ID}" entry`);
}

const titleId = `${SECTION_ID}-title`;
const cap = (text: string) => capitalizeFirst(text, lang);
---

{experience.items.length > 0 && (
  <section
    id={SECTION_ID}
    aria-labelledby={titleId}
    class="my-16 px-(--section-gutter) md:my-24"
  >
    <SectionCard
      titleId={titleId}
      title={experience.title}
      class="mx-auto max-w-section"
    >
      {experience.items.map((job, jobIndex) => {
        const id = `${SECTION_ID}-${jobIndex}`;
        return (
          <article class="lg:grid lg:grid-cols-2">
            <div class="lg:pe-10">
              <h3>{job.role}</h3>
              <p class="mt-1 font-heading text-lg font-semibold text-accent">
                {job.company}
              </p>
              {/* The middle dot is the separator spec §6.2 uses; screen readers skip it. */}
              <p class="mt-2 text-muted">
                {cap(job.period)} <span aria-hidden="true">·</span>{' '}
                {cap(job.location)}
              </p>
              <p class="mt-4">
                {cap(job.description)} {cap(job.context)}
              </p>
              <div class="mt-8 rounded-2xl border border-well-border bg-well p-4 shadow-(--well-shadow) sm:p-5">
                <h4 id={`${id}-tech`} class="text-base">
                  {experience.technologiesLabel}
                </h4>
                <ul
                  aria-labelledby={`${id}-tech`}
                  class="mt-3 flex flex-wrap gap-2"
                >
                  {job.chips.map((chip) => (
                    <li>
                      <TechPill name={chip} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="mt-10 border-t border-glass-border pt-8 lg:mt-0 lg:border-t-0 lg:border-s lg:ps-10 lg:pt-0">
              <div
                role="tablist"
                aria-label={experience.labels.highlights}
                class="mb-6 hidden flex-wrap gap-2 in-data-theme:flex"
              >
                {job.highlights.map(({ tab }, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`${id}-tab-${i}`}
                    aria-controls={`${id}-panel-${i}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    class="inline-flex min-h-11 items-center rounded-lg border border-muted px-4 font-medium text-text not-aria-selected:hover:border-accent not-aria-selected:hover:text-accent aria-selected:border-btn-bg aria-selected:bg-btn-bg aria-selected:text-btn-text"
                  >
                    {tab}
                  </button>
                ))}
              </div>
              <div class="tab-panels">
                {job.highlights.map(({ title, text }, i) => (
                  <div
                    id={`${id}-panel-${i}`}
                    data-active={i === 0 ? '' : undefined}
                    class="rounded-sm"
                  >
                    <h4>{title}</h4>
                    <p class="mt-2">{cap(text)}</p>
                  </div>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </SectionCard>
  </section>
)}

<script src="../../scripts/tabs.ts"></script>
