---
// Hero (spec §6.1): a single glass panel, as wide as the section cards and narrower than the
// header bar (max-w-section and the --section-gutter gutter). Text first; from md the portrait
// takes a right-hand column. The portrait
// sits on the panel's bottom edge and the panel clips it (overflow-hidden and its radius); behind
// it, a soft jade glow in plain CSS, so there is no nested glass.
import { Picture } from 'astro:assets';
import portrait from '../../assets/portrait/portrait.webp';
import { CV_PATHS } from '../../config';
import type { Locale } from '../../i18n/config';
import { getContent } from '../../i18n/utils';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { hero, profile, ui } = getContent(lang);

const socialLinks = [
  { href: profile.github, label: ui.social.github, icon: 'github' },
  { href: profile.linkedin, label: ui.social.linkedin, icon: 'linkedin' },
] as const;
---

<section class="px-(--section-gutter) pt-4 pb-8 md:pt-6">
  <div class="glass mx-auto grid max-w-section overflow-hidden rounded-3xl md:grid-cols-[minmax(0,1fr)_auto]">
    <div class="self-center p-5 sm:p-8 lg:p-10">
      {/* The space between the spans keeps the accessible name from running both lines together. */}
      <h1>
        <span class="block">{hero.name}</span>{' '}
        <span class="mt-2 block text-h2 text-accent">{hero.role}</span>
      </h1>
      <p class="mt-6 text-balance">{hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={CV_PATHS[lang]}
          download
          type="application/pdf"
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-btn-bg px-5 font-medium text-btn-text no-underline"
        >
          {hero.cta.cv}
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex min-h-11 items-center justify-center rounded-lg border-2 border-accent px-5 font-medium text-text no-underline hover:text-accent"
        >
          {hero.cta.contact}
        </a>
      </div>
      {/* Neutral pills: the visible text is the whole accessible name; the icon is aria-hidden. */}
      <ul class="mt-3 flex flex-wrap gap-3">
        {socialLinks.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-glass-border px-4 font-medium text-text no-underline hover:border-accent hover:text-accent"
            >
              <Icon name={icon} class="size-5" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {/*
     * items-end keeps the image on the bottom edge, with no padding below it. The master's last
     * rows are a soft, half-transparent edge: -mb-0.5 pushes them 2px under the panel edge, where
     * overflow-hidden cuts them, so no 1px seam shows at fractional zoom levels.
     */}
    <div class="flex items-end justify-center bg-[radial-gradient(ellipse_at_50%_65%,var(--portrait-glow),transparent_70%)] md:pt-8">
      <Picture
        src={portrait}
        alt={hero.portraitAlt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[400, 800, 1200]}
        sizes="(min-width: 80rem) 28rem, (min-width: 64rem) 24rem, (min-width: 48rem) 20rem, 18rem"
        width={448}
        height={448}
        fetchpriority="high"
        loading="eager"
        class="-mb-0.5 block h-auto w-72 max-w-full md:w-80 lg:w-96 xl:w-112"
      />
    </div>
  </div>
</section>
