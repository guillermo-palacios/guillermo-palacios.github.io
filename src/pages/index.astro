---
// Temporary design-token test page (task 4): replaced by [lang]/index.astro and the root redirect
// in task 5. Its strings are demo labels, not site content.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import soraWoff2 from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import { SITE_INDEXABLE, SITE_NAME } from '../config';
import '../styles/global.css';

const cards = [1, 2, 3];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!SITE_INDEXABLE && <meta name="robots" content="noindex" />}
    <title>{SITE_NAME}</title>
    <!-- Moves to BaseLayout in task 6. -->
    <link
      rel="preload"
      href={soraWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:py-24">
      <p class="text-sm text-muted">Página de prueba temporal · tarea 4</p>
      <h1 class="mt-2">Tokens de diseño, mesh y tarjetas de cristal</h1>
      <p class="mt-6">
        Texto base en Inter con interlineado 1,6. Este párrafo es lo bastante
        largo como para partirse en varias líneas y comprobar el ancho máximo de
        70 caracteres, el contraste sobre el fondo con mesh y que el cambio de
        la fuente de reserva a la definitiva no desplaza nada.
      </p>
      <p class="mt-4 text-muted">
        Texto atenuado para fechas, metadatos y notas secundarias. Debe seguir
        siendo legible sobre los puntos más intensos del mesh en los dos temas.
      </p>
      <p class="mt-4">
        Un <a href="#tarjetas">enlace de prueba</a> dentro de un párrafo,
        subrayado para que el color no sea la única señal.
      </p>
      <button
        type="button"
        class="mt-8 inline-flex min-h-11 items-center rounded-full bg-btn-bg px-6 font-semibold text-btn-text"
      >
        Botón primario
      </button>

      <section id="tarjetas" aria-labelledby="tarjetas-titulo" class="mt-16">
        <h2 id="tarjetas-titulo">Tarjetas glass</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {cards.map((n) => (
            <article class="glass rounded-2xl p-6">
              <h3>Tarjeta {n}</h3>
              <p class="mt-3">
                Texto base sobre la capa semiopaca, con desenfoque del mesh que
                queda detrás.
              </p>
              <p class="mt-3 text-sm text-muted">
                Texto atenuado de 0,875 rem.
              </p>
              <p class="mt-3">
                <a href="#tarjetas">Enlace en tarjeta</a>
              </p>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
