---
// Static build: Astro writes an HTML page with meta refresh and canonical to /es/.
// 301 keeps the refresh delay at 0 (with 302 Astro waits 2 s).
import { DEFAULT_LOCALE } from '../i18n/config';
import { getLocalePath } from '../i18n/utils';

return Astro.redirect(getLocalePath(DEFAULT_LOCALE), 301);
---
